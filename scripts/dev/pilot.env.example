# Pilot (copilot) company template for create-company.sh. Copy it, fill the blanks, never commit the copy:
#   cp scripts/dev/pilot.env.example scripts/dev/<company>.env
#   CREATE_COMPANY_ENV=scripts/dev/<company>.env ./scripts/dev/create-company.sh

PILOT=true
TIME_ZONE=Europe/Bucharest
CURRENCY=RON
CONTRACT_MONTHS=36
INSURANCE_PROVIDER=Generali
HELMET_PROVIDER=Giro
# Shared pilot bikes (Graveler, Kreidler Lady, Kross Dust, Kenevo SL 2, Orbea Wild, Levo Expert) — checked active + in stock at run time.
COPILOT_BIKE_IDS=cf018dd2-05ed-4717-aca1-2a91d4192735,a65d80ba-26b4-4f7c-806a-781f8070c4d7,4da378cc-6e30-4f9b-bc63-8a3cb7148b2d,e58cace6-5e0c-4371-839b-17ccf2354273,ca78d4e9-5216-4bad-8f2e-4c94f5f0ed53,1e65c35c-9a3a-4aeb-9ba9-a12d0ff729e4
HR_FIRST_NAME=HR

# Per company
COMPANY_NAME=
DESCRIPTION=
EMAIL_DOMAIN=
MONTHLY_BENEFIT_SUBSIDY=
HR_EMAIL=
HR_LAST_NAME=
CONTACT_EMAIL=
LOGO_PATH=
# ISO with offset, e.g. 2026-11-12T10:00:00+02:00. Empty → step 2 says "HR will contact you".
LIVE_TEST_AT=
# Empty → a random 20-char password, printed once at the end.
HR_PASSWORD=
